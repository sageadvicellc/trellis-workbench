# The corpus allowlist decides which repositories' code may be sent to
# model providers. Each entry needs the founder's egress clearance, so
# the founder owns this file. Requiring code-owner review is a repository
# setting, and it is the owner's to turn on.
/corpus/allowlist.txt @hannasage
/corpus/tasks/ @hannasage
/.github/CODEOWNERS @hannasage

# The founder also owns the workflows and the spend guard, because they
# decide what runs and what it may spend.
/.github/ @hannasage
/bench/spend_guard.py @hannasage
/bench/egress.py @hannasage
/bench/guards.py @hannasage
